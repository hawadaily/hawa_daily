rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    match /articles/{articleId}/comments/{commentId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to comment
    }

    match /articles/{articleId}/likes/{likesId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to like
    }

    match /articles/{articleId}/dislikes/{dislikesId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to dislike
    }

    match /articles/{articleId}/reactions/{reactionId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to write reactions
    }

    match /articles/{articleId}/userReactions/{userId} {
      allow read: if true; // Allow reading reactions for everyone
      allow write: if true; // Allow anonymous users to write reactions
    }

    match /articles/{articleId}/comments/{commentId}/userReactions/{userId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to react to comments
    }

    match /articles/{articleId}/comments/{commentId}/likes/{likesId} {
      allow read: if true;
      allow write: if true;
    }

    match /articles/{articleId}/comments/{commentId}/dislikes/{dislikesId} {
      allow read: if true;
      allow write: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sidebar-promotions/{promotionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mid-article-promotions/{promotionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /visitors/{visitorId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth.uid == userId;
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /recipe-reactions/{recipeId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to react
    }

    match /recipe-user-reactions/{reactionId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to write reactions
    }

    match /recipe-comments/{commentId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to comment
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /page-stats/{pageId} {
      allow read: if true;
      allow write: if true;
    }

    match /page-stats/{pageId}/visits/{visitId} {
      allow read: if true;
      allow write: if true;
    }

    match /quran/{surahId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /analytics-cache/{cacheId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
