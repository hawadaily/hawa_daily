rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /real-stories/{storyId} {
      allow read: if true;
      allow write: if true; // Auth is handled in main project
    }

    match /real-stories/{storyId}/episodes/{episodeId} {
      allow read: if true;
      allow write: if true; // Auth is handled in main project
    }

    match /real-stories/{storyId}/episodes/{episodeId}/comments/{commentId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to comment
    }

    match /real-stories/{storyId}/episodes/{episodeId}/likes/{likeId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to like
    }

    match /real-stories/{storyId}/episodes/{episodeId}/dislikes/{dislikeId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to dislike
    }

    match /real-stories/{storyId}/episodes/{episodeId}/userReactions/{userId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to write reactions
    }

    match /real-stories/{storyId}/episodes/{episodeId}/comments/{commentId}/userReactions/{userId} {
      allow read: if true;
      allow write: if true; // Allow anonymous users to react to comments
    }

    match /real-stories/{storyId}/episodes/{episodeId}/comments/{commentId}/likes/{likeId} {
      allow read: if true;
      allow write: if true;
    }

    match /real-stories/{storyId}/episodes/{episodeId}/comments/{commentId}/dislikes/{dislikeId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
